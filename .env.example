# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Echo Global Logistics Credentials (for automation)
ECHO_USERNAME=your-echo-username
ECHO_PASSWORD=your-echo-password
ECHO_PORTAL_URL=https://login.echo.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTOMATION_SECRET=your-secret-key-for-webhook

# Storage
SUPABASE_STORAGE_BUCKET=screenshots

# Google Sheets — Customer Database
# The spreadsheet must be set to "Anyone with the link can view"
# Spreadsheet ID is from the URL: /spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1ecgQAeiA6QlC8eSPbEtW4PSlo-le4rxQTq6I1t7Jd7E
# GID is the sheet tab ID (visible in URL after #gid=)
GOOGLE_SHEETS_GID=2013673483
